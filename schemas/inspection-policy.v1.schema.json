{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://large-image-ingest.dev/schemas/inspection-policy.v1.schema.json",
  "title": "Large Image Ingest Inspection Policy Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version"],
  "properties": {
    "schemaVersion": { "const": "large-image-ingest.inspection-policy.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "metadataProfile": { "$ref": "inspection-profile.v1.schema.json" },
    "requireOriginalPreserved": { "type": "boolean" },
    "requireWholeFileChecksum": { "type": "boolean" },
    "requiredChecksumAlgorithm": { "const": "sha256" },
    "allowedCompletionStatuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["verified", "completed-unverified"] }
    },
    "requireStoredChecksum": { "type": "boolean" },
    "maxSourceBytes": { "type": "integer", "minimum": 0 },
    "allowedMediaTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
