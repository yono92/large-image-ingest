{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://large-image-ingest.dev/schemas/inspection-profile.v1.schema.json",
  "title": "Large Image Ingest Inspection Metadata Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "fields"],
  "properties": {
    "schemaVersion": { "const": "large-image-ingest.inspection-profile.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" },
          "required": { "type": "boolean" },
          "type": { "enum": ["string", "number", "integer", "boolean"] },
          "minLength": { "type": "integer", "minimum": 0 },
          "maxLength": { "type": "integer", "minimum": 0 },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "enum": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" }
              ]
            }
          },
          "pattern": { "type": "string", "maxLength": 256, "pattern": "^\\^.*\\$$" }
        }
      }
    }
  }
}
